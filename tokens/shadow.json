{
  "shadow": {
    "x": {
      "$value": "0",
      "$type": "dimension"
    },
    "y": {
      "$value": "1px",
      "$type": "dimension"
    },
    "blur": {
      "$value": "3px",
      "$type": "dimension"
    },
    "spread": {
      "$value": "0px",
      "$type": "dimension"
    },
    "opacity": {
      "$value": "0.1",
      "$type": "number"
    },
    "color": {
      "$value": "#000000",
      "$type": "color"
    },
    "2xs": {
      "$value": "0 1px 3px 0px hsl(0 0% 0% / 0.05)",
      "$type": "shadow"
    },
    "xs": {
      "$value": "0 1px 3px 0px hsl(0 0% 0% / 0.05)",
      "$type": "shadow"
    },
    "sm": {
      "$value": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 1px 2px -1px hsl(0 0% 0% / 0.10)",
      "$type": "shadow"
    },
    "DEFAULT": {
      "$value": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 1px 2px -1px hsl(0 0% 0% / 0.10)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 2px 4px -1px hsl(0 0% 0% / 0.10)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 4px 6px -1px hsl(0 0% 0% / 0.10)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 8px 10px -1px hsl(0 0% 0% / 0.10)",
      "$type": "shadow"
    },
    "2xl": {
      "$value": "0 1px 3px 0px hsl(0 0% 0% / 0.25)",
      "$type": "shadow"
    }
  }
}