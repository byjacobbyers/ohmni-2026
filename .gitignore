# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/


# cursor
/.cursor/
.cursor/
.cursor


# claude
/.claude/
/CLAUDE.md

# private planning and business docs
/plans/


# pnpm store
/.pnpm-store/


# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sanity TypeGen artifacts (regenerate with `pnpm typegen`)
/schema.json
# sanity.types.ts is committed so fetch sites stay typed without a local typegen run
