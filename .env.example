# --- Sanity (existing) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_LOCAL_URL="http://localhost:3000"
NEXT_PUBLIC_GTM_ID=

# --- Contact form / email (existing) ---
RESEND_API_KEY=
CONTACT_FORM_RECIPIENT_EMAIL=
CONTACT_FORM_FROM_EMAIL=

# --- PostHog (BUILD-PLAN Task 1; analytics off when unset) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Inngest + Attio lead pipeline (BUILD-PLAN Task 2) ---
# Unset -> /api/send falls back to the direct email-only path.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local dev only (never in Vercel): routes events to `npx inngest-cli dev`
# instead of Inngest Cloud. Required since inngest v4 for local runs.
INNGEST_DEV=1
ATTIO_API_KEY=
# Slack incoming-webhook URL for pipeline failure alerts (optional)
SLACK_ALERT_WEBHOOK_URL=

# --- Customer.io lifecycle email (phase 2; journeys trigger on lead_submitted) ---
# Track API credentials: Workspace Settings -> API Credentials -> Track API
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=
# Set to "eu" only for EU-region workspaces
CUSTOMERIO_REGION=
