# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional override; defaults to v2025-02-19 in sanity/env.ts
NEXT_PUBLIC_SANITY_API_VERSION=
# Server fetches (draft + published). Prefer a token with read access only.
SANITY_API_READ_TOKEN=
# Viewer-role token for draft mode + SanityLive in the browser (Presentation).
# Required by /api/draft-mode/enable. Prefer this over exposing the read token.
SANITY_VIEWER_TOKEN=
SANITY_REVALIDATE_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_LOCAL_URL="http://localhost:3000"
NEXT_PUBLIC_GTM_ID=

# --- Contact form / email ---
RESEND_API_KEY=
CONTACT_FORM_RECIPIENT_EMAIL=
CONTACT_FORM_FROM_EMAIL=

# --- PostHog (analytics off when unset) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Inngest + Attio lead pipeline ---
# Unset -> /api/send falls back to the direct email-only path.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local dev only (never in Vercel): routes events to `npx inngest-cli dev`
INNGEST_DEV=1
ATTIO_API_KEY=
# Slack incoming-webhook URL for pipeline failure alerts (optional)
SLACK_ALERT_WEBHOOK_URL=

# --- Customer.io lifecycle email ---
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=
# Set to "eu" only for EU-region workspaces
CUSTOMERIO_REGION=
